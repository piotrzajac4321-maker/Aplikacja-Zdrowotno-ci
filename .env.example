# Skopiuj ten plik jako .env i wypełnij prawdziwymi wartościami.
# .env nie jest commitowany (patrz .gitignore).

# === Supabase (osobny projekt dla tej aplikacji!) ===
# Settings -> API w panelu Supabase
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# === Flask ===
FLASK_ENV=development
SECRET_KEY=change-me-in-production-to-a-long-random-string
